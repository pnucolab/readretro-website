# Global options
{
	# Enable automatic HTTPS
	email admin@readretro.net
}

# HTTP to HTTPS redirect
http://readretro.net {
	redir https://readretro.net{uri} permanent
}

# HTTPS server
readretro.net {
	# Enable TLS
	tls {
		protocols tls1.2 tls1.3
	}
	
	# Serve robots.txt
	handle /robots.txt {
		file_server {
			root /static
		}
	}
	
	# API routes - remove /api/v1 prefix and forward to backend
	handle /api/v1/* {
		uri strip_prefix /api/v1
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Forwarded-Port {server_port}
		}
	}
	
	# Static files
	handle /static/* {
		file_server {
			root /static
		}
	}
	
	# Default route - forward to frontend
	handle {
		reverse_proxy frontend:3000 {
			header_up Host {host}
		}
	}
}
